{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "HealthCareCSAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "HealthCareCSAgent"
  },
  "runtimes": [
    {
      "name": "HealthCareCSAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/HealthCareCSAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "CustMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "CSGateway",
      "protocolType": "None",
      "description": "Gateway for CSGateway",
      "targets": [],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "CSPolicyEngine",
        "mode": "LOG_ONLY"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "CSPolicyEngine",
      "policies": []
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}